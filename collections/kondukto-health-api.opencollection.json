{
  "opencollection": "1.0.0",
  "info": {
    "name": "Invicti ASPM (Kondukto) REST API v2 Authorization Managers Health API",
    "version": "3.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Cookie",
      "value": "{{X-Cookie}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health Check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}/api/v2/health/check/"
          },
          "docs": "Api health check"
        }
      ]
    }
  ],
  "bundled": true
}