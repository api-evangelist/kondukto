{
  "opencollection": "1.0.0",
  "info": {
    "name": "Invicti ASPM (Kondukto) REST API v2 Authorization Managers Products API",
    "version": "3.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Cookie",
      "value": "{{X-Cookie}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Products",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Products",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}/api/v2/products/",
            "headers": [
              {
                "name": "X-Cookie",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "How many records will return"
              },
              {
                "name": "start",
                "value": "",
                "type": "query",
                "description": "Offset for pagination"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Product name to filter. Works as \"contains\""
              }
            ]
          },
          "docs": "Returns the list of products."
        },
        {
          "info": {
            "name": "Create a Product",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{hostname}/api/v2/products/",
            "headers": [
              {
                "name": "X-Cookie",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This endpoint lets you create a new product. The product name should be unique and should not contain any spaces."
        },
        {
          "info": {
            "name": "Get Product Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}/api/v2/products/:productID",
            "headers": [
              {
                "name": "X-Cookie",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "productID",
                "value": "",
                "type": "path",
                "description": "Product ID"
              }
            ]
          },
          "docs": "Returns the details of a product."
        },
        {
          "info": {
            "name": "Update a Product",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{hostname}/api/v2/products/:productID",
            "headers": [
              {
                "name": "X-Cookie",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "productID",
                "value": "",
                "type": "path",
                "description": "Product ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Overwrites the projects of a product by the given values."
        }
      ]
    }
  ],
  "bundled": true
}